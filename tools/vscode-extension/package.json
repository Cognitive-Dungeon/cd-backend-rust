{
  "name": "cognitive-dungeon-sdk",
  "displayName": "Cognitive Dungeon SDK",
  "description": "Visual Data Editor & Runtime Telemetry for CDE",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cde-explorer",
          "title": "Cognitive Dungeon",
          "icon": "$(game)"
        }
      ]
    },
    "languages": [
      {
        "id": "json",
        "extensions": [".cdb"],
        "aliases": ["Cognitive Database", "cdb"]
      }
    ],
    "views": {
      "cde-explorer": [
        {
          "id": "cde.entities",
          "name": "Runtime Entities",
          "icon": "$(list-flat)"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "cde.data",
        "displayName": "CDB Editor",
        "selector": [
          {
            "filenamePattern": "*.cdb"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "cde.connect",
        "title": "Connect to Engine",
        "category": "CDE"
      },
      {
        "command": "cde.disconnect",
        "title": "Disconnect",
        "category": "CDE"
      },
      {
        "command": "cde.openTelemetry",
        "title": "Open Telemetry Panel",
        "category": "CDE"
      },
      {
        "command": "cde.refreshEntities",
        "title": "Refresh Entities",
        "icon": "$(refresh)",
        "category": "CDE"
      },
      {
        "command": "cde.newDataFile",
        "title": "Create Database (.cdb)",
        "category": "CDE"
      },
      {
        "command": "cde.openCdbAsJson",
        "title": "Open CDB as JSON",
        "icon": "$(json)",
        "category": "CDE"
      },
      {
        "command": "cde.openCdbAsTable",
        "title": "Open CDB as Table",
        "icon": "$(list-flat)",
        "category": "CDE"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cde.openCdbAsJson",
          "when": "activeCustomEditorId == cde.data",
          "group": "navigation"
        },
        {
          "command": "cde.openCdbAsTable",
          "when": "resourceExtname == .cdb && activeCustomEditorId != cde.data",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "cde.refreshEntities",
          "when": "view == cde.entities",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Cognitive Dungeon SDK",
      "properties": {
        "cde.engineUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "Engine HTTP base URL"
        },
        "cde.defaults.newFileName": {
          "type": "string",
          "default": "game.cdb"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "svelte-build": "rollup -c",
    "svelte-dev": "rollup -c -w"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^14.0.0",
    "@rollup/plugin-node-resolve": "^8.0.0",
    "@rollup/plugin-replace": "^2.3.4",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "postcss": "^8.2.4",
    "postcss-import": "^14.0.0",
    "rollup": "^2.3.4",
    "rollup-plugin-postcss": "^4.0.0",
    "rollup-plugin-svelte": "^6.1.1",
    "rollup-plugin-terser": "^7.0.0",
    "svelte": "^3.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "object-resolve-path": "^1.1.1",
    "sveltejs-tippy": "^3.0.0",
    "uuid": "^8.3.0"
  }
}